# Copy to .env and adjust. All variables are optional.

# auto  -> use YOLO weights if JASS_MODEL_PATH exists, otherwise fall back to the dummy detector
# yolo  -> require YOLO weights (fails at startup if missing)
# dummy -> always return a fake detection (useful for frontend/API work before a model exists)
JASS_MODEL_BACKEND=auto
JASS_MODEL_PATH=models/best.pt
JASS_DEVICE=cpu
JASS_CONF_THRESHOLD=0.25
JASS_IOU_THRESHOLD=0.45
JASS_IMG_SIZE=640
JASS_MAX_UPLOAD_MB=10

# Frontend -> API
JASS_API_URL=http://api:8000

# Host ports
API_PORT=8000
FRONTEND_PORT=8501
